{
  "name": "gaku-niku",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node local-agent-bridge/launch.mjs",
    "bridge": "node local-agent-bridge/server.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:standalone": "esbuild standalone/main.tsx --bundle --outfile=standalone/dist/app.js --platform=browser --format=iife --target=es2022",
    "start": "vinext start",
    "test": "vinext build && esbuild standalone/main.tsx --bundle --outfile=standalone/dist/app.js --platform=browser --format=iife --target=es2022 && node --test",
    "runtime:check": "node scripts/validate-runtime-manifest.mjs",
    "runtime:prepare": "node scripts/prepare-runtime-toolchain.mjs",
    "release:portable": "node scripts/build-portable-release.mjs",
    "release:smoke": "node scripts/smoke-portable-release.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "7.24.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
